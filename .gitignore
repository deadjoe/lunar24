# Build directories
/build/
/build-asan/
/build-tsan/
/build-rel/
/build-debug/
/cmake-build-*/
**/build/

# task #85 (GH #19) probe output — deterministic, regenerable by the probe, not committed
# (the committed work artifacts are report/gh19-analyze.tsv + report/gh19-check.txt, from the same data).
/report/gh19-probe/

# task #88 (GH #20) probe output — deterministic, regenerable by the probe, not committed
# (the committed work artifact is the task#88 report .md, from the same data).
/report/gh20-probe-trap/

# IDE / OS cruft
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Python bytecode cache (analysis/generator scripts)
__pycache__/
*.py[cod]

# Logs / temporary files
*.log
*.tmp
*.bak
*.orig

# Secrets — never commit
.env
*.key
*.pem
*.p12
secrets/

# ELTA Solar 42N reference source materials.
# Binaries (extracted manual text, panel render, effector catalog images) are kept
# LOCAL ONLY to avoid carrying third-party full materials if this repo ever goes
# public. Source URL + checksums + extraction notes live in design/reference/SOURCES.md.
design/reference/*.png
design/reference/solar42N_manual_text.txt
# The ORIGINAL vendor PDFs (manual + panel scan) are ELTA Music copyright and must
# never be committed — they were previously untracked but NOT ignored, so any
# `git add -A` would have pulled 75 MB of vendor material into a public repo.
design/reference/*.pdf

# iPlug2 is a pinned git submodule (third_party/iPlug2, see .gitmodules + the pin gate
# in tools/check_iplug_pin_clean.py). It is tracked as a submodule, so it is NOT ignored;
# submodule working-tree dirt is checked by the pin gate, not by this file.
